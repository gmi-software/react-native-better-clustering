{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "package",
    "example",
    "docs"
  ],
  "trustedDependencies": [
    "react-native-better-clustering"
  ],
  "scripts": {
    "android": "cd example && expo run:android",
    "ios": "cd example && expo run:ios",
    "start": "cd example && expo start --dev-client",
    "docs:start": "cd docs && bun run start",
    "docs:build": "cd docs && bun run build",
    "commitlint": "commitlint",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cpp": "bash scripts/clang-format.sh"
  },
  "overrides": {
    "react-native-reanimated": "4.5.0",
    "react-native-worklets": "0.10.0",
    "webpack": "5.105.4",
    "webpackbar": "6.0.1",
    "@docusaurus/core": "3.9.2",
    "@docusaurus/bundler": "3.9.2",
    "@docusaurus/plugin-content-docs": "3.9.2",
    "@docusaurus/theme-translations": "3.9.2",
    "@docusaurus/utils": "3.9.2",
    "@docusaurus/utils-common": "3.9.2",
    "@docusaurus/utils-validation": "3.9.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.14",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
