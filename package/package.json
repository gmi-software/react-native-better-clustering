{
  "name": "react-native-better-clustering",
  "version": "1.0.0",
  "description": "A faster react-native-map-clustering — same MapView API, C++/Nitro supercluster engine under the hood",
  "author": "gmi.software",
  "license": "MIT",
  "homepage": "https://gmi.software/open-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmi-software/react-native-better-clustering.git"
  },
  "bugs": {
    "url": "https://github.com/gmi-software/react-native-better-clustering/issues"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./utils": {
      "types": "./lib/typescript/utils/index.d.ts",
      "react-native": "./src/utils/index.ts",
      "import": "./lib/module/utils/index.js",
      "default": "./lib/module/utils/index.js"
    },
    "./engine": {
      "types": "./lib/typescript/engine/index.d.ts",
      "react-native": "./src/engine/index.ts",
      "import": "./lib/module/engine/index.js",
      "default": "./lib/module/engine/index.js"
    },
    "./geojson": {
      "types": "./lib/typescript/geojson/index.d.ts",
      "react-native": "./src/geojson/index.ts",
      "import": "./lib/module/geojson/index.js",
      "default": "./lib/module/geojson/index.js"
    },
    "./hooks": {
      "types": "./lib/typescript/hooks/index.d.ts",
      "react-native": "./src/hooks/index.ts",
      "import": "./lib/module/hooks/index.js",
      "default": "./lib/module/hooks/index.js"
    },
    "./compat": {
      "types": "./lib/typescript/compat/index.d.ts",
      "react-native": "./src/compat/index.ts",
      "import": "./lib/module/compat/index.js",
      "default": "./lib/module/compat/index.js"
    },
    "./clusterer": {
      "types": "./lib/typescript/clusterer/index.d.ts",
      "react-native": "./src/clusterer/index.ts",
      "import": "./lib/module/clusterer/index.js",
      "default": "./lib/module/clusterer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "cpp/*.hpp",
    "cpp/*.cpp",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.js",
    "!**/*.test.d.ts",
    "!cpp/*.test.cpp",
    "!cpp/cluster_test",
    "!cpp/cluster_bench"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bun run specs && bob build",
    "prepack": "bun run specs && cp ../README.md ./README.md && bob build",
    "postpack": "rm ./README.md",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "specs": "nitrogen",
    "test": "bun test --isolate",
    "test:watch": "bun test --watch",
    "test:ci": "bun test --isolate",
    "verify:pack": "node scripts/verify-pack.mjs",
    "release": "release-it",
    "verify:exports": "node scripts/verify-exports.mjs"
  },
  "keywords": [
    "react-native",
    "nitro",
    "map",
    "clustering",
    "react-native-maps",
    "supercluster"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@react-native/eslint-config": "0.85.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.15",
    "nitrogen": "0.35.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-maps": "^1.26.0",
    "react-native-nitro-modules": "0.35.9",
    "react-native-reanimated": "^4.5.0",
    "release-it": "^21.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-maps": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "react-native-maps": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.test.ts,*.test.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
